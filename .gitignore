# Dependencies
node_modules/

# Docusaurus build output
build/
.docusaurus/
.cache-loader/

# Generated / search
.swc/

# Generated content index (Spec 003, T034) — rebuilt by prestart/prebuild;
# not source of truth, no need to track drift in git.
static/content-index.json

# Generated content-status report (Spec 010, T027) — same convention as
# content-index.json above: rebuilt by prestart/prebuild, not source of truth.
static/content-status.json
static/catalog-courses.json

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Environment
.env
.env.local
.env.*.local

# Supabase CLI local state (Spec 002). Note: supabase/config.toml,
# supabase/migrations/ and supabase/functions/ ARE tracked — only local
# runtime state is ignored.
supabase/.temp/
supabase/.branches/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

