# Dependencies
node_modules/

# Docusaurus build output
build/
.docusaurus/
.cache-loader/

# Generated / search
.swc/

# Generated content index (Spec 003, T034) — rebuilt by prestart/prebuild;
# not source of truth, no need to track drift in git.
static/content-index.json

# Generated content-status report (Spec 010, T027) — same convention as
# content-index.json above: rebuilt by prestart/prebuild, not source of truth.
static/content-status.json
static/catalog-courses.json

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Environment
.env
.env.local
.env.*.local

# Supabase CLI local state (Spec 002). Note: supabase/config.toml,
# supabase/migrations/ and supabase/functions/ ARE tracked — only local
# runtime state is ignored.
supabase/.temp/
supabase/.branches/

# Logs
*.log
# ...except review-evidence command logs, which the Feature 014 contract requires to be
# committed alongside a report. Without this carve-out a report validates locally and fails on a
# fresh CI checkout, because its evidence_manifest names files git refused to track.
!specs/content/**/reviews/**/*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Spec 006: quiz/answer-key staging worksheets — never committed (FR-018)
specs/content/**/.staging/

# Spec 009: figure generation staging (raster drops awaiting optimise) — never committed (FR-004)
specs/content/**/figures/.staging/

# 2025 course guides: 108 MB of source PDFs/RTFs, against a 27 MB repo history.
# The extracted text under Scheme-and-Course-guides/extracted-text/course-guides-2025/
# is committed instead - it is what the pipeline reads and what makes the licence
# blueprint auditable.
#
# The originals are not lost by ignoring them. They are the HEC pre-service
# course guides, published at
# https://www.hec.gov.pk/english/services/universities/RevisedCurricula/Pages/Education.aspx
# which is also the source STEDA's own syllabus cites for Part II. Anyone can
# re-download them; the committed text is a derivative, not the record of record.
#
# Reversible: drop the two patterns below to track the binaries.
# Owner decision 2026-09-13, recorded in specs/content/licence-blueprint.md.
Scheme-and-Course-guides/course-guides-2025/*.pdf
Scheme-and-Course-guides/course-guides-2025/*.rtf

# Feature 015 T001: pre-refactor gate output, captured so FR-009's byte-identical
# comparison is mechanical rather than remembered. Local only, never committed.
specs/015-licence-content-tree/baseline/

# NOTE: `review-ref/` was removed on 2026-09-20 and is deliberately NOT ignored any more.
# The comment here used to say `review-evidence.mjs prepare` needed an immutable copy of the
# repo to compute digests against. That has not been true since `prepare` started hashing git's
# index directly (`tracked()` in scripts/lib/review-evidence.mjs), and no script references the
# path. Meanwhile the ignore rule was doing active harm: EFMP-302 Unit 3's run-007 review found
# the snapshot shadowed 108 bound paths with older bytes, 36 of them differing, and because it
# was ignored it never entered a manifest and `prepare` never reported it dirty - so a reviewer
# could open superseded content and still validate cleanly. Leaving the path unignored means any
# future snapshot shows up as untracked, which `dirtyInputs()` scans with
# `--untracked-files=all` and will refuse to prepare against.
build-*/
