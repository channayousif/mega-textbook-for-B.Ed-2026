# Spec 002 — Authentication & Roles
# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# PUBLIC — these ship to the browser bundle via docusaurus.config.ts customFields.
# The anon key is safe to publish ONLY because Row-Level Security is enabled on
# every table (Constitution Art. V.1/V.2). It grants nothing on its own.
# ---------------------------------------------------------------------------
DOCUSAURUS_SUPABASE_URL=https://your-project-ref.supabase.co
DOCUSAURUS_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# SECRET — never expose to the browser. Used only by Edge Functions
# (admin-suspend, delete-account) and by the RLS test suite to seed fixtures.
#
# Set for Edge Functions with:  supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#
# If this value ever appears under src/, `npm run check:no-service-key` fails
# the build. That is a release blocker, not a warning.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Google OAuth (Supabase local stack reads these via config.toml env() refs).
# From the Google Cloud OAuth consent screen / credentials page.
# ---------------------------------------------------------------------------
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
