 "fig-U8-6.ur.svg": {
  "viewBox": "780x470",
  "dividers": [
   648,
   360,
   576
  ],
  "textCount": 36,
  "crossed": [
   {
    "text": "سب سے پہلے سنے جانے کے لیے،",
    "divider": 576,
    "textX": 467.7,
    "textRight": 636,
    "y": 90
   },
   {
    "text": "سوچ جاتے ہوئے",
    "divider": 576,
    "textX": 557.1,
    "textRight": 636,
    "y": 110
   },
   {
    "text": "قربت، پھر ذاتی بات؛",
    "divider": 360,
    "textX": 301.3,
    "textRight": 408,
    "y": 90
   },
   {
    "text": "باری کا قاعدہ",
    "divider": 360,
    "textX": 339.7,
    "textRight": 408,
    "y": 110
   },
   {
    "text": "کام کی پکڑ نہیں یا",
    "divider": 576,
    "textX": 540.6,
    "textRight": 636,
    "y": 184
   },
   {
    "text": "پہلا مرحلہ نہیں",
    "divider": 576,
    "textX": 561.7,
    "textRight": 636.5,
    "y": 204
   },
   {
    "text": "کام کا آغاز جانچیں؛",
    "divider": 360,
    "textX": 308.6,
    "textRight": 408,
    "y": 184
   },
   {
    "text": "ایسا کام جس میں چلنا پڑے",
    "divider": 360,
    "textX": 266.5,
    "textRight": 408,
    "y": 204
   },
   {
    "text": "یقینی ناکامی، یا",
    "divider": 576,
    "textX": 554.8,
    "textRight": 636.5,
    "y": 278
   },
   {
    "text": "بچاؤ کا چکر",
    "divider": 576,
    "textX": 574.4,
    "textRight": 636,
    "y": 298
   },
   {
    "text": "گم شدہ مرحلہ ڈھونڈیں؛",
    "divider": 360,
    "textX": 285.3,
    "textRight": 408,
    "y": 278
   },
   {
    "text": "انتخاب، الٹی میٹم نہیں",
    "divider": 360,
    "textX": 292.6,
    "textRight": 408,
    "y": 298
   },
   {
    "text": "بحث کا کوئی اور",
    "divider": 576,
    "textX": 547.6,
    "textRight": 636,
    "y": 372
   },
   {
    "text": "پرسکون الگ کریں؛ ریکارڈ",
    "divider": 360,
    "textX": 272.6,
    "textRight": 408.5,
    "y": 372
   },
   {
    "text": "اور ساتھ والدین سے ملاقات",
    "divider": 360,
    "textX": 263.1,
    "textRight": 408,
    "y": 392
   }
  ],
  "outside": []
 },
