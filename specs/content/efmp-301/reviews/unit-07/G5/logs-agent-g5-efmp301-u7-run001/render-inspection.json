 "figures": {
  "fig-U7-1.ur": {
   "viewBox": "0 0 780 470",
   "texts": [
    {
     "text": "جو دعوی کیا جاتا ہے",
     "x": 579.2,
     "y": 36.2,
     "w": 125.6,
     "h": 15.7
    },
    {
     "text": "تحقیق نے کیا پایا",
     "x": 337.3,
     "y": 36.2,
     "w": 105.4,
     "h": 15.7
    },
    {
     "text": "جو رکھنے",
     "x": 108,
     "y": 28.2,
     "w": 60,
     "h": 15.7
    },
    {
     "text": "لائق ہے",
     "x": 116.3,
     "y": 48.2,
     "w": 43.5,
     "h": 15.7
    },
    {
     "text": "ہر شاگرد کا ایک پکا طرز ہے،",
     "x": 619.9,
     "y": 101.2,
     "w": 136.1,
     "h": 14.7
    },
    {
     "text": "بصری، سماعتی یا حرکی",
     "x": 638.1,
     "y": 121.2,
     "w": 117.9,
     "h": 14.7
    },
    {
     "text": "طرز اپنی زبانی بتائی",
     "x": 404.7,
     "y": 101.2,
     "w": 99.3,
     "h": 14.7
    },
    {
     "text": "پسند ہیں، ناپی ہوئی اقسام نہیں",
     "x": 353.5,
     "y": 121.2,
     "w": 150.5,
     "h": 14.7
    },
    {
     "text": "شاگرد مختلف ہیں -",
     "x": 158.8,
     "y": 101.2,
     "w": 93.2,
     "h": 14.7
    },
    {
     "text": "یہ بات سچ ہے",
     "x": 187.8,
     "y": 121.2,
     "w": 64.2,
     "h": 13.8
    },
    {
     "text": "طرز کے مطابق تدریس سے",
     "x": 624.8,
     "y": 215.2,
     "w": 131.2,
     "h": 14.7
    },
    {
     "text": "تعلم بہتر ہو جاتا ہے",
     "x": 666.7,
     "y": 235.2,
     "w": 89.3,
     "h": 14.7
    },
    {
     "text": "مطابقت والی تحقیق کم یا",
     "x": 379,
     "y": 215.2,
     "w": 125,
     "h": 14.7
    },
    {
     "text": "کوئی فائدہ نہیں دکھاتی",
     "x": 395.8,
     "y": 235.2,
     "w": 108.6,
     "h": 14.7
    },
    {
     "text": "ایک سے زیادہ انداز میں پیش",
     "x": 117.9,
     "y": 215.2,
     "w": 134.1,
     "h": 14.7
    },
    {
     "text": "کرنا زیادہ شاگردوں تک پہنچتا ہے",
     "x": 100.8,
     "y": 235.2,
     "w": 151.6,
     "h": 14.7
    },
    {
     "text": "طرز یہ بتاتا ہے کہ شاگرد",
     "x": 641.4,
     "y": 329.2,
     "w": 114.6,
     "h": 14.7
    },
    {
     "text": "مشکل کیوں محسوس کرتا ہے",
     "x": 613.2,
     "y": 349.2,
     "w": 142.8,
     "h": 14.7
    },
    {
     "text": "مشکل عموماً کام، سابقہ علم یا",
     "x": 354.1,
     "y": 327.7,
     "w": 149.9,
     "h": 16.3
    },
    {
     "text": "تدریس تک جا کر ملتی ہے",
     "x": 383.1,
     "y": 349.2,
     "w": 120.9,
     "h": 14.7
    },
    {
     "text": "شاگرد سے پہلے کام",
     "x": 158.3,
     "y": 329.2,
     "w": 93.7,
     "h": 14.7
    },
    {
     "text": "کا تقاضا دیکھیں",
     "x": 177.8,
     "y": 349.2,
     "w": 74.6,
     "h": 14.7
    },
    {
     "text": "حقیقی فرق کی غلط وضاحت ہمیشہ شاگرد کو تن",
     "x": 385.8,
     "y": 386.2,
     "w": 370.2,
     "h": 15.7
    },
    {
     "text": "textbook.com.pk",
     "x": 675.7,
     "y": 450.2,
     "w": 92.8,
     "h": 12.8
    }
   ],
