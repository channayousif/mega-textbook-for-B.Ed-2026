    "@remotion/renderer": "4.0.535",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.535",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "18.3.23",
    "tsx": "4.20.5",
