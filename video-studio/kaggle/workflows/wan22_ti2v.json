{
  "_comment": "Wan2.2-TI2V-5B in ComfyUI API format, from Comfy-Org template video_wan2_2_5B_ti2v.json. $name strings are filled by video_bench.py; for t2v it removes node 6 and the start_image input. Tiled VAE decode and SaveImage replace VAEDecode and SaveVideo (host RAM, deterministic x264 encode).",
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "$unet", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "$clip", "type": "wan", "device": "default" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "$vae" } },
  "4": { "class_type": "CLIPTextEncode", "inputs": { "text": "$positive", "clip": ["2", 0] } },
  "5": { "class_type": "CLIPTextEncode", "inputs": { "text": "$negative", "clip": ["2", 0] } },
  "6": { "class_type": "LoadImage", "inputs": { "image": "$image" } },
  "7": { "class_type": "Wan22ImageToVideoLatent", "inputs": { "vae": ["3", 0], "width": "$width", "height": "$height", "length": "$length", "batch_size": 1, "start_image": ["6", 0] } },
  "8": { "class_type": "ModelSamplingSD3", "inputs": { "model": ["1", 0], "shift": "$shift" } },
  "9": { "class_type": "KSampler", "inputs": { "model": ["8", 0], "seed": "$seed", "steps": "$steps", "cfg": "$cfg", "sampler_name": "$sampler", "scheduler": "$scheduler", "positive": ["4", 0], "negative": ["5", 0], "latent_image": ["7", 0], "denoise": 1.0 } },
  "10": { "class_type": "VAEDecodeTiled", "inputs": { "samples": ["9", 0], "vae": ["3", 0], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8 } },
  "11": { "class_type": "SaveImage", "inputs": { "images": ["10", 0], "filename_prefix": "$prefix" } }
}
