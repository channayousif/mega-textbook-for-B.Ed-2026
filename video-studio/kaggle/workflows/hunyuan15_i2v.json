{
  "_comment": "HunyuanVideo-1.5 image-to-video in ComfyUI API format, adapted from Comfy-Org template video_hunyuan_video_1.5_720p_i2v.json (base pass only, no super-resolution). KSampler replaces SamplerCustomAdvanced; settings come from candidates.json. $name strings are filled by video_bench.py.",
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "$unet", "weight_dtype": "default" } },
  "2": { "class_type": "DualCLIPLoader", "inputs": { "clip_name1": "$clip1", "clip_name2": "$clip2", "type": "hunyuan_video_15", "device": "default" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "$vae" } },
  "4": { "class_type": "CLIPTextEncode", "inputs": { "text": "$positive", "clip": ["2", 0] } },
  "5": { "class_type": "CLIPTextEncode", "inputs": { "text": "$negative", "clip": ["2", 0] } },
  "6": { "class_type": "LoadImage", "inputs": { "image": "$image" } },
  "12": { "class_type": "CLIPVisionLoader", "inputs": { "clip_name": "$clip_vision" } },
  "13": { "class_type": "CLIPVisionEncode", "inputs": { "clip_vision": ["12", 0], "image": ["6", 0], "crop": "center" } },
  "7": { "class_type": "HunyuanVideo15ImageToVideo", "inputs": { "positive": ["4", 0], "negative": ["5", 0], "vae": ["3", 0], "width": "$width", "height": "$height", "length": "$length", "batch_size": 1, "start_image": ["6", 0], "clip_vision_output": ["13", 0] } },
  "8": { "class_type": "ModelSamplingSD3", "inputs": { "model": ["1", 0], "shift": "$shift" } },
  "9": { "class_type": "KSampler", "inputs": { "model": ["8", 0], "seed": "$seed", "steps": "$steps", "cfg": "$cfg", "sampler_name": "$sampler", "scheduler": "$scheduler", "positive": ["7", 0], "negative": ["7", 1], "latent_image": ["7", 2], "denoise": 1.0 } },
  "10": { "class_type": "VAEDecodeTiled", "inputs": { "samples": ["9", 0], "vae": ["3", 0], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8 } },
  "11": { "class_type": "SaveImage", "inputs": { "images": ["10", 0], "filename_prefix": "$prefix" } }
}
