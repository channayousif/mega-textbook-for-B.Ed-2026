{
  "name": "bed-mega-textbook",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual (English + Urdu) digital textbook for the B.Ed (4-Year) programme — Docusaurus content platform.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "prestart": "node scripts/build-content-index.mjs && node scripts/report-content-status.mjs",
    "start": "docusaurus start",
    "prebuild": "node scripts/build-content-index.mjs && node scripts/report-content-status.mjs",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "build:content-index": "node scripts/build-content-index.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check:no-answer-keys": "node scripts/check-no-answer-keys.mjs",
    "check:concept-graph": "node scripts/check-concept-graph.mjs",
    "check:bloom-bands": "node scripts/check-bloom-bands.mjs",
    "check:source-floor": "node scripts/check-source-floor.mjs",
    "check:pipeline-gate": "node scripts/check-pipeline-gate.mjs",
    "check:depth-gate": "node scripts/check-unit-depth.mjs",
    "check:figures": "node scripts/check-figures.mjs",
    "check:no-em-dash": "node scripts/check-no-em-dash.mjs",
    "check:licence": "node scripts/check-licence.mjs --allow-missing",
    "licence:map": "node scripts/build-licence-map.mjs",
    "licence:map:check": "node scripts/build-licence-map.mjs --check",
    "build:content-status": "node scripts/report-content-status.mjs",
    "check:content-status": "node scripts/report-content-status.mjs --check",
    "optimize:figure": "node scripts/optimize-figure.mjs",
    "check:add-course": "node scripts/check-add-course.mjs",
    "scaffold": "node scripts/scaffold-catalog.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:review": "node --test tests/review/*.test.mjs",
    "review:evidence": "node scripts/review-evidence.mjs",
    "test:e2e": "playwright test",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "check:no-service-key": "node scripts/check-no-service-key.mjs",
    "check:docs-sync": "node scripts/check-docs-sync.mjs",
    "check:content": "node scripts/run-gates.mjs content",
    "check:all": "node scripts/run-gates.mjs full",
    "ci:local": "node scripts/local-ci.mjs",
    "figures:variants": "node scripts/build-figure-variants.mjs",
    "figures:variants:check": "node scripts/build-figure-variants.mjs --check",
    "gates:evidence": "node scripts/prepare-gate-evidence.mjs",
    "agent:job": "node scripts/agent-job.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.2",
    "@mdx-js/react": "^3.0.0",
    "@supabase/supabase-js": "^2.110.7",
    "clsx": "^2.1.0",
    "exceljs": "^4.4.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@huggingface/inference": "^4.13.28",
    "@playwright/test": "^1.48.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "sharp": "^0.35.4",
    "typescript": "~5.6.0",
    "vitest": "^2.1.0"
  }
}
