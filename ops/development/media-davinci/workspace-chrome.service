[Unit]
Description=Workspace Chrome on the VNC desktop (NotebookLM, Meta AI, Business Suite); CDP on 127.0.0.1:9222 for nlm

[Service]
Environment=DISPLAY=:1
Environment=XAUTHORITY=%h/.Xauthority
ExecStartPre=/bin/sh -c "until [ -S /tmp/.X11-unix/X1 ]; do sleep 2; done"
ExecStart=/usr/bin/google-chrome --user-data-dir=%h/.local/share/workspace-chrome --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1 --no-first-run --password-store=basic https://notebooklm.google.com https://www.meta.ai https://business.facebook.com
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
