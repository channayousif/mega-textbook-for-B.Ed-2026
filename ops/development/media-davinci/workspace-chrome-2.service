[Unit]
Description=Second-account workspace Chrome on the VNC desktop (NotebookLM for nlm profile "second", Feature 036); CDP on 127.0.0.1:9223
After=workspace-chrome.service

[Service]
Environment=DISPLAY=:1
Environment=XAUTHORITY=%h/.Xauthority
ExecStartPre=/bin/sh -c "until [ -S /tmp/.X11-unix/X1 ]; do sleep 2; done"
ExecStart=/usr/bin/google-chrome --user-data-dir=%h/.local/share/workspace-chrome-2 --remote-debugging-port=9223 --remote-debugging-address=127.0.0.1 --no-first-run --password-store=basic --class=workspace-chrome-2 https://notebooklm.google.com
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
