#!/usr/bin/env python3
"""Bounded private metadata logs. Never persist argv, environment or credentials."""
import collections
import datetime
import json
import os
from pathlib import Path
import subprocess
import time

STATE = Path.home() / '.local/state/development-containment'
STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
os.umask(0o077)
BASE = Path('/sys/fs/cgroup')
UNITS = ('development.slice', 'development-editor.slice', 'development-agents.slice')


def read(path):
    try:
        return path.read_text().strip()
    except OSError:
        return None


def group(unit):
    result = subprocess.run(['systemctl', '--user', 'show', unit, '-p', 'ControlGroup', '--value'],
                            capture_output=True, text=True, timeout=5)
    return result.stdout.strip()


def disks():
    # /proc/diskstats includes completed I/O, ticks and weighted queue ticks.
    result = {}
    for line in Path('/proc/diskstats').read_text().splitlines():
        fields = line.split()
        if fields[2].startswith(('loop', 'ram')):
            continue
        result[fields[2]] = [int(v) for v in fields[3:]]
    return result


previous_disks = disks()
over_since = None
warned = False
while True:
    now = time.monotonic()
    sample = {'time': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'slices': {}}
    editor_group = ''
    for unit in UNITS:
        cg = group(unit)
        if unit == 'development-editor.slice':
            editor_group = cg
        sample['slices'][unit] = {name: read(BASE / cg.lstrip('/') / name) if cg else None
                                 for name in ('memory.current', 'memory.events', 'memory.pressure',
                                              'io.pressure', 'cpu.stat', 'io.stat')}
    sample['psi'] = {kind: read(Path('/proc/pressure') / kind) for kind in ('memory', 'io', 'cpu')}
    current_disks = disks()
    sample['disks'] = {}
    for name, values in current_disks.items():
        old = previous_disks.get(name, values)
        completed = values[0] + values[4] - old[0] - old[4]
        ticks = values[3] + values[7] - old[3] - old[7]
        sample['disks'][name] = {'await_ms': ticks / completed if completed > 0 else 0,
                                'io_ticks_delta': values[9] - old[9],
                                'weighted_ticks_delta': values[10] - old[10]}
    previous_disks = current_disks
    roles = collections.Counter()
    outside = collections.Counter()
    for proc in Path('/proc').glob('[0-9]*'):
        try:
            if proc.stat().st_uid != os.getuid():
                continue
            cg = (proc / 'cgroup').read_text().strip().split('::', 1)[1]
            # Inspect arguments in memory only to classify VS Code child roles.
            args = (proc / 'cmdline').read_bytes().replace(b'\0', b' ')
            role = next((role for marker, role in (
                (b'--type=extensionHost', 'extension-host'), (b'--type=fileWatcher', 'watcher'),
                (b'--type=ptyHost', 'terminal-host'), (b'server-main.js', 'server'),
                (b'.vscode-server', 'editor-other')) if marker in args), 'other')
            if editor_group and (cg == editor_group or cg.startswith(editor_group + '/')):
                roles[role] += 1
            elif role != 'other':
                outside[role] += 1
        except (OSError, IndexError):
            continue
    sample['editor_roles'] = dict(roles)
    sample['uncontained_editor_roles'] = dict(outside)
    usage = sample['slices']['development-editor.slice']['memory.current']
    over = usage is not None and int(usage) > 2560 * 1024 * 1024
    over_since = (now if over_since is None else over_since) if over else None
    if over_since is None:
        warned = False
    if over_since is not None and now - over_since >= 60 and not warned:
        subprocess.run(['logger', '-t', 'development-containment',
                        'Editor usage above 2.5 GiB for 60 seconds; save work and inspect extensions.'], check=False)
        subprocess.run(['wall', 'Editor memory above 2.5 GiB for 60 seconds; save work.'],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        warned = True
    log = STATE / 'samples.jsonl'
    if log.exists() and log.stat().st_size >= 5 * 1024 * 1024:
        for index in range(3, 0, -1):
            source = STATE / ('samples.jsonl' if index == 1 else f'samples.jsonl.{index - 1}')
            if source.exists():
                source.replace(STATE / f'samples.jsonl.{index}')
    with log.open('a') as stream:
        stream.write(json.dumps(sample) + '\n')
    time.sleep(30)
