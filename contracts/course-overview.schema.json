{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bed-textbook/contracts/course-overview.schema.json",
  "title": "Course-overview front-matter",
  "description": "Contract for course-overview.mdx front-matter. Carries course-wide items (teaching strategies, assessment criteria, recommended resources) referenced by units (FR-007, Spec 006 CP9).",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "course_code", "credit_hours", "category"],
  "not": {
    "anyOf": [
      { "required": ["answer_key"] },
      { "required": ["marking_scheme"] }
    ]
  },
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "course_code": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{3}(--)?$" },
    "credit_hours": { "type": "string", "minLength": 1, "description": "e.g. '3 (3-0)'" },
    "category": {
      "enum": [
        "General Education",
        "Major: Professional",
        "Major: Pedagogy",
        "Major: Elective",
        "Major: Practical",
        "Interdisciplinary",
        "Internship",
        "Capstone Project",
        "Licence track"
      ]
    },
    "assessment_weighting": {
      "type": "object",
      "required": ["summative", "formative"],
      "additionalProperties": false,
      "properties": {
        "summative": { "type": "integer", "minimum": 0, "maximum": 100 },
        "formative": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "default": { "summative": 60, "formative": 40 }
    },
    "bilingual": {
      "type": "boolean",
      "default": true,
      "description": "false marks an English-only course (e.g. Functional English) exempt from the EN<->UR parity gate (Constitution III.2)."
    },
    "teaching_strategies": { "type": "array", "items": { "type": "string" } },
    "assessment_criteria": { "type": "array", "items": { "type": "string" } },
    "practical_work": { "type": "array", "items": { "type": "string" } },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "type": { "type": "string" }
        }
      }
    }
  }
}
